      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" } }
      },
      "targets": [
        { "expr": "sum(increase(vigyanllm_registrations_total[1h])) by (method)", "legendFormat": "{{method}}", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Tool Usage Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 } }
      },
      "targets": [
        { "expr": "sum(increase(vigyanllm_tool_runs_total[1h])) by (tool)", "legendFormat": "{{tool}}", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "piechart",
      "title": "Tool Usage by Type",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": {} },
      "targets": [
        { "expr": "sum(increase(vigyanllm_tool_runs_total[24h])) by (tool)", "legendFormat": "{{tool}}", "refId": "A" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "pieType": "donut" }
    },
    {
      "type": "bargauge",
      "title": "Conversion Funnel",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        { "expr": "sum(increase(http_requests_total{endpoint=\"/\"}[24h]))", "legendFormat": "Page Visits", "refId": "A" },
        { "expr": "sum(increase(vigyanllm_tool_runs_total[24h]))", "legendFormat": "Tool Runs", "refId": "B" },
        { "expr": "sum(increase(vigyanllm_registrations_total[24h]))", "legendFormat": "Registrations", "refId": "C" },
        { "expr": "sum(increase(vigyanllm_payments_total{event=\"success\"}[24h]))", "legendFormat": "Payments", "refId": "D" }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "gauge",
      "title": "Payment Success Rate",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.95 } ] }
        }
      },
      "targets": [
        { "expr": "sum(rate(vigyanllm_payments_total{event=\"success\"}[1h])) / (sum(rate(vigyanllm_payments_total{event=\"success\"}[1h])) + sum(rate(vigyanllm_payments_total{event=\"failure\"}[1h])))", "legendFormat": "Success Rate", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "type": "timeseries",
      "title": "Revenue Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "stacking": { "mode": "normal" } } }
      },
      "targets": [
        { "expr": "sum(increase(vigyanllm_payments_total{event=\"success\"}[1h])) by (plan)", "legendFormat": "{{plan}}", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Pipeline Runs Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "expr": "sum(increase(vigyanllm_pipeline_step_seconds_count[1h])) by (step)", "legendFormat": "{{step}}", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    }
