        "defaults": {
          "thresholds": { "steps": [ { "color": "blue", "value": null } ] }
        }
      },
      "targets": [
        { "expr": "sum(increase(vigyanllm_tool_runs_total[24h]))", "legendFormat": "Tool Runs", "refId": "A" }
      ],
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
